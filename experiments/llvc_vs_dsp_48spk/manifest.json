  {"utt_id": "utt_10056268918865128986", "speaker": "speaker_14421868454726886678", "locale": "ar_eg", "gender": "female", "sec": 4.14, "text": "ماهو أكبر الشرايين حجما ًفي جسم الإنسان؟"},
  {"utt_id": "utt_9460860140304307823", "speaker": "speaker_14421868454726886678", "locale": "ar_eg", "gender": "female", "sec": 4.44, "text": "ماهو الأسلوب الدرامي في الشعر العربي ؟"},
  {"utt_id": "utt_17639847973013336485", "speaker": "speaker_14421868454726886678", "locale": "ar_eg", "gender": "female", "sec": 3.18, "text": "أين سكن الاغريق ؟"},
  {"utt_id": "utt_13765569517932221541", "speaker": "speaker_14421868454726886678", "locale": "ar_eg", "gender": "female", "sec": 4.62, "text": "متى حاز ماكس بلانك على جائزة نوبل في الفيزياء؟"},
  {"utt_id": "utt_18031441350459496027", "speaker": "speaker_14421868454726886678", "locale": "ar_eg", "gender": "female", "sec": 3.42, "text": "ما أهمية الإجتماعات في الشركات؟"},
  {"utt_id": "utt_15192351908109658902", "speaker": "speaker_18093347100302319540", "locale": "ar_eg", "gender": "female", "sec": 3.9, "text": "كيف تحولت إيران إلى دولة مسلمة ؟"},
  {"utt_id": "utt_10450128654758500656", "speaker": "speaker_18093347100302319540", "locale": "ar_eg", "gender": "female", "sec": 3.96, "text": "متى تمّ إحتلال سوريا من قبل فرنسا؟"},
  {"utt_id": "utt_4798752821904455224", "speaker": "speaker_18093347100302319540", "locale": "ar_eg", "gender": "female", "sec": 2.88, "text": "من هو نيكولاس كوبرنيكوس؟"},
  {"utt_id": "utt_18252351639445904623", "speaker": "speaker_18093347100302319540", "locale": "ar_eg", "gender": "female", "sec": 3.78, "text": "ما هي أطول فترات حكم فلاد الثالث؟"},
  {"utt_id": "utt_15502183196419887237", "speaker": "speaker_18093347100302319540", "locale": "ar_eg", "gender": "female", "sec": 4.26, "text": "من هي أول إمراة عربية حصلت على جائزة النوبل؟"},
  {"utt_id": "utt_17168538450223757423", "speaker": "speaker_2488707421431849825", "locale": "ar_eg", "gender": "female", "sec": 2.94, "text": "ما هي المقاومة الكهربائية ؟"},
  {"utt_id": "utt_9662111903346161535", "speaker": "speaker_2488707421431849825", "locale": "ar_eg", "gender": "female", "sec": 3.12, "text": "متى تأسست الدولة العباسية؟"},
  {"utt_id": "utt_15792521783020535897", "speaker": "speaker_2488707421431849825", "locale": "ar_eg", "gender": "female", "sec": 3.42, "text": "متى تاسست الحركة الصهيونية؟"},
  {"utt_id": "utt_16265654512556188154", "speaker": "speaker_2488707421431849825", "locale": "ar_eg", "gender": "female", "sec": 3.42, "text": "ما هي اكبر ولاية أمريكية من حيث السكان؟"},
  {"utt_id": "utt_12049836269057937242", "speaker": "speaker_2488707421431849825", "locale": "ar_eg", "gender": "female", "sec": 3.72, "text": "ماهو علاج التسمم بالأكسجين  ؟"},
  {"utt_id": "utt_10462742628448737700", "speaker": "speaker_14923726139779559574", "locale": "ar_eg", "gender": "male", "sec": 4.26, "text": "ماجنسية الممثل معتصم النهار؟"},
  {"utt_id": "utt_15118263063998081198", "speaker": "speaker_14923726139779559574", "locale": "ar_eg", "gender": "male", "sec": 5.4, "text": "أين ولدت هيلينا بتروفنا بلافاتسكي؟"},
  {"utt_id": "utt_4859434798760470489", "speaker": "speaker_14923726139779559574", "locale": "ar_eg", "gender": "male", "sec": 4.32, "text": "متى ولد جوزيِفْ هايدِنمؤلف؟"},
  {"utt_id": "utt_12664114218285448673", "speaker": "speaker_14923726139779559574", "locale": "ar_eg", "gender": "male", "sec": 4.2, "text": "كم تبعد جزيرة فيلكا عن الساحل الكويتي؟"},
  {"utt_id": "utt_11787590104630929080", "speaker": "speaker_14923726139779559574", "locale": "ar_eg", "gender": "male", "sec": 4.68, "text": "من أدى صوت المحقق كونان في نسخته العربية ؟"},
  {"utt_id": "utt_6434421651907571382", "speaker": "speaker_15098567047504942696", "locale": "ar_eg", "gender": "male", "sec": 4.62, "text": "ما هما النوعان المختلفين لمرض البيريبيري ؟"},
  {"utt_id": "utt_2913900406494100658", "speaker": "speaker_15098567047504942696", "locale": "ar_eg", "gender": "male", "sec": 4.08, "text": "ما هي الأصول غير الملموسة؟"},
  {"utt_id": "utt_10300958636653153415", "speaker": "speaker_15098567047504942696", "locale": "ar_eg", "gender": "male", "sec": 4.5, "text": "هل يمكن الوفاة جراء جرعة زائدة من الكيتامين ؟"},
  {"utt_id": "utt_10587496045213564028", "speaker": "speaker_15098567047504942696", "locale": "ar_eg", "gender": "male", "sec": 3.36, "text": "متى بنيت مدينة القاهرة؟"},
  {"utt_id": "utt_15750854974826780836", "speaker": "speaker_15098567047504942696", "locale": "ar_eg", "gender": "male", "sec": 3.72, "text": "ما هو اخطر انواع سمك القرش ؟"},
  {"utt_id": "utt_3088430633426629229", "speaker": "speaker_12092027127695124612", "locale": "ar_eg", "gender": "male", "sec": 2.4, "text": "ما هو عدد ولايات المكسيك؟"},
  {"utt_id": "utt_8060511710034603701", "speaker": "speaker_12092027127695124612", "locale": "ar_eg", "gender": "male", "sec": 2.64, "text": "ما هي الباربتيورات؟"},
  {"utt_id": "utt_11779785318007731243", "speaker": "speaker_12092027127695124612", "locale": "ar_eg", "gender": "male", "sec": 3.84, "text": "كم عدد مؤلفات الرافعي المنشورة؟"},
  {"utt_id": "utt_6149308214530925927", "speaker": "speaker_12092027127695124612", "locale": "ar_eg", "gender": "male", "sec": 3.66, "text": "ما معنى اسم الخَوْر؟"},
  {"utt_id": "utt_18268366288036689595", "speaker": "speaker_12092027127695124612", "locale": "ar_eg", "gender": "male", "sec": 3.0, "text": "ما هي عاصمة جمهورية أذربيجان؟"},
  {"utt_id": "utt_12432863714090254660", "speaker": "speaker_14776489627952268221", "locale": "ar_eg", "gender": "male", "sec": 4.26, "text": "من هو جروفر كليفلاند؟"},
  {"utt_id": "utt_4527447618810083660", "speaker": "speaker_14776489627952268221", "locale": "ar_eg", "gender": "male", "sec": 3.6, "text": "في أي عام ولد بيل غيتس؟"},
  {"utt_id": "utt_8294452582627532280", "speaker": "speaker_14776489627952268221", "locale": "ar_eg", "gender": "male", "sec": 4.14, "text": "ما هي الحروب النابليونية؟"},
  {"utt_id": "utt_9723799694864936062", "speaker": "speaker_14776489627952268221", "locale": "ar_eg", "gender": "male", "sec": 5.76, "text": "كيف توفيت ديان فوسي ؟"},
  {"utt_id": "utt_16706987294451520800", "speaker": "speaker_14776489627952268221", "locale": "ar_eg", "gender": "male", "sec": 3.54, "text": "ما عدد أقسام الجهازالهضمي؟"},
  {"utt_id": "utt_1759902478789513348", "speaker": "speaker_8090770265384760955", "locale": "ar_eg", "gender": "male", "sec": 4.5, "text": "في أي عام ولد نابوليون بونابارت؟"},
  {"utt_id": "utt_10266895115973879786", "speaker": "speaker_8090770265384760955", "locale": "ar_eg", "gender": "male", "sec": 5.88, "text": "من كان لاعب الهجوم الأساس في نادي الاهلي الليبي عام 2010 ؟"},
  {"utt_id": "utt_17567693482309216472", "speaker": "speaker_8090770265384760955", "locale": "ar_eg", "gender": "male", "sec": 3.42, "text": "أين نشأت موسيقى الكانتري؟"},
  {"utt_id": "utt_14157826298112338558", "speaker": "speaker_8090770265384760955", "locale": "ar_eg", "gender": "male", "sec": 3.9, "text": "من رئيس ألمانيا النازية في الحرب العالمية الثانية؟"},
  {"utt_id": "utt_12897429335635112007", "speaker": "speaker_8090770265384760955", "locale": "ar_eg", "gender": "male", "sec": 3.42, "text": "أين عاش المغني ملحم بركات؟"},
  {"utt_id": "utt_2543908804921296283", "speaker": "speaker_8532510621625254089", "locale": "ar_eg", "gender": "male", "sec": 4.2, "text": "كم بلغ عدد سكان اليمن لعام 2011؟"},
  {"utt_id": "utt_18244309732675234079", "speaker": "speaker_8532510621625254089", "locale": "ar_eg", "gender": "male", "sec": 3.24, "text": "من هو الرئيس الإسباني ؟"},
  {"utt_id": "utt_14278606585419006446", "speaker": "speaker_8532510621625254089", "locale": "ar_eg", "gender": "male", "sec": 3.36, "text": "كم يبلغ طول نهر الاردن؟"},
  {"utt_id": "utt_12100918050099856262", "speaker": "speaker_8532510621625254089", "locale": "ar_eg", "gender": "male", "sec": 3.36, "text": "من هي مؤلفة الرواية الملعونة؟"},
  {"utt_id": "utt_17634988859937100298", "speaker": "speaker_8532510621625254089", "locale": "ar_eg", "gender": "male", "sec": 4.2, "text": "كم عدد اولاد الرئيس الراحل حافظ الاسد؟"},
  {"utt_id": "utt_10083080225663389298", "speaker": "speaker_15877947996960536327", "locale": "ar_eg", "gender": "male", "sec": 3.9, "text": "من هي جولي إيزابيل بيشوب؟"},
  {"utt_id": "utt_8262172170521112337", "speaker": "speaker_15877947996960536327", "locale": "ar_eg", "gender": "male", "sec": 4.32, "text": "كم عدد حلقات هجوم العمالقة الموسم الثاني؟"},
  {"utt_id": "utt_1109293536297197885", "speaker": "speaker_15877947996960536327", "locale": "ar_eg", "gender": "male", "sec": 3.12, "text": "من صاحب رواية العمى؟"},
  {"utt_id": "utt_6618697592337684976", "speaker": "speaker_15877947996960536327", "locale": "ar_eg", "gender": "male", "sec": 4.92, "text": "متى أصدرت أغنية كاتيوشا الروسية؟"},
  {"utt_id": "utt_14943962010941696637", "speaker": "speaker_15877947996960536327", "locale": "ar_eg", "gender": "male", "sec": 4.5, "text": "في اي مدينة توجد عجلة فالكيرك؟"},
  {"utt_id": "utt_16468389757084110603", "speaker": "speaker_1815058134649154248", "locale": "ar_eg", "gender": "male", "sec": 4.5, "text": "من صاحب أسرع هدف تم تسجيله في دوري أبطال أوربا؟"},
