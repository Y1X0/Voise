  {"utt_id": "utt_13276775502488990068", "speaker": "speaker_6018594005180370908", "locale": "ar_x_gulf", "gender": "female", "sec": 4.08, "text": "أين تقع مدينة سانت بطرسبرغ؟"},
  {"utt_id": "utt_15767065354525438513", "speaker": "speaker_6018594005180370908", "locale": "ar_x_gulf", "gender": "female", "sec": 3.6, "text": "متي توفي بايزيد الأوَّل؟"},
