  {"utt_id": "utt_5872190830116822290", "speaker": "speaker_15424754379219516590", "locale": "ar_x_gulf", "gender": "female", "sec": 4.44, "text": "من سفيرالمملكة العربية السعودية بأسنطبول؟"},
  {"utt_id": "utt_12464328179885373761", "speaker": "speaker_15424754379219516590", "locale": "ar_x_gulf", "gender": "female", "sec": 4.92, "text": "من أطلق الأسطورة السوداء الإسبانية لتشويه سمعة إسبانيا؟"},
  {"utt_id": "utt_10873758981521233996", "speaker": "speaker_15424754379219516590", "locale": "ar_x_gulf", "gender": "female", "sec": 4.2, "text": "من هو علي بن عبد الرحمن الحذيفي؟"},
  {"utt_id": "utt_202048551125217695", "speaker": "speaker_10006021021369897647", "locale": "ar_x_gulf", "gender": "female", "sec": 3.06, "text": "هل يمكن قياس عمر الجليد ؟"},
