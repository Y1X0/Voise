  {"utt_id": "utt_17055383626193976960", "speaker": "speaker_12288978262070828269", "locale": "ar_x_gulf", "gender": "female", "sec": 2.76, "text": "ما هي اصغر مدينة في الأردن؟"},
  {"utt_id": "utt_4262846738117991035", "speaker": "speaker_10262733535774594490", "locale": "ar_x_gulf", "gender": "male", "sec": 4.02, "text": "أين تكثر ظاهرة الإستغلال الجنسي للأطفال ؟"},
  {"utt_id": "utt_1747905560676680947", "speaker": "speaker_10262733535774594490", "locale": "ar_x_gulf", "gender": "male", "sec": 3.66, "text": "كم تبلغ مساحة قلعة حلب؟"},
  {"utt_id": "utt_16806619769075871396", "speaker": "speaker_10262733535774594490", "locale": "ar_x_gulf", "gender": "male", "sec": 3.54, "text": "إلى من ترجع تسمية الساسانيين؟"},
  {"utt_id": "utt_2749437120456165079", "speaker": "speaker_10262733535774594490", "locale": "ar_x_gulf", "gender": "male", "sec": 5.46, "text": "من الشركة التي أنتجت فيلم الكرتون مدغشقر 1؟"},
  {"utt_id": "utt_17606877165710299519", "speaker": "speaker_10262733535774594490", "locale": "ar_x_gulf", "gender": "male", "sec": 5.16, "text": "متى تحولت الجزيرة الرياضية إلى بيين سبورت؟"},
  {"utt_id": "utt_5297968300333867392", "speaker": "speaker_1129865831649933500", "locale": "ar_x_gulf", "gender": "no_answer", "sec": 4.2, "text": "ما هي الأطراف التي تنازعت في معركة طرف الغار؟"},
  {"utt_id": "utt_1612534403413741332", "speaker": "speaker_1129865831649933500", "locale": "ar_x_gulf", "gender": "no_answer", "sec": 3.0, "text": "أين يوجد الملح الصخري؟"},
  {"utt_id": "utt_13258669807753083826", "speaker": "speaker_1129865831649933500", "locale": "ar_x_gulf", "gender": "no_answer", "sec": 2.88, "text": "ما هو سبب مرض الأيدز ؟"},
  {"utt_id": "utt_9861669997004766577", "speaker": "speaker_1129865831649933500", "locale": "ar_x_gulf", "gender": "no_answer", "sec": 3.48, "text": "متى أعتبرت بغداد كعاصمة عباسيّة ؟"},
  {"utt_id": "utt_11613682504675170541", "speaker": "speaker_1129865831649933500", "locale": "ar_x_gulf", "gender": "no_answer", "sec": 3.6, "text": "ماهو تعداد سكان الجُمهُورِيَّة البُولندِيَّة ؟"},
  {"utt_id": "utt_10728721403401637113", "speaker": "speaker_15051406154135117591", "locale": "ar_x_gulf", "gender": "female", "sec": 6.66, "text": "هل يوجد جهاز لقياس قوة الفك؟"},
  {"utt_id": "utt_5892094897616375910", "speaker": "speaker_15051406154135117591", "locale": "ar_x_gulf", "gender": "female", "sec": 8.76, "text": "متى حدثة أول انتخابات رئاسية تعددية في مصر ؟"},
  {"utt_id": "utt_7816190969192677551", "speaker": "speaker_15051406154135117591", "locale": "ar_x_gulf", "gender": "female", "sec": 7.92, "text": "هل يسبب ألإكثار من تناول الملح مرض السكري؟"},
  {"utt_id": "utt_10936946510385313846", "speaker": "speaker_15051406154135117591", "locale": "ar_x_gulf", "gender": "female", "sec": 6.72, "text": "من مخترع المجهر الضوئي ؟"},
  {"utt_id": "utt_5337198565202369324", "speaker": "speaker_15051406154135117591", "locale": "ar_x_gulf", "gender": "female", "sec": 6.84, "text": "في أي عام تأسست جامعة كامبرج؟"},
  {"utt_id": "utt_2718680712731407014", "speaker": "speaker_13622788734606429792", "locale": "ar_x_gulf", "gender": "female", "sec": 4.02, "text": "ما هي أكبر مدن الجزائر؟"},
  {"utt_id": "utt_13099537293764689774", "speaker": "speaker_13622788734606429792", "locale": "ar_x_gulf", "gender": "female", "sec": 5.22, "text": "ما عدد المحافظات في سوريا؟"},
  {"utt_id": "utt_2763337973932081974", "speaker": "speaker_13622788734606429792", "locale": "ar_x_gulf", "gender": "female", "sec": 4.8, "text": "متى تم اول اعلان لحقوق الأنسان ؟"},
  {"utt_id": "utt_7822009359001903367", "speaker": "speaker_13622788734606429792", "locale": "ar_x_gulf", "gender": "female", "sec": 7.62, "text": "متى حاز جوردن الكسندر سبيث على لقب أفضل لاعب جولف مبتدئ؟"},
  {"utt_id": "utt_8378284445561092171", "speaker": "speaker_13622788734606429792", "locale": "ar_x_gulf", "gender": "female", "sec": 10.68, "text": "كم دامت فترة الخليفة العباسي الخامس أبو جعفر هارون بن محمد المهدي بن أبي جعفر المنصور؟"},
  {"utt_id": "utt_14291519143785085526", "speaker": "speaker_2766335412638966296", "locale": "ar_x_gulf", "gender": "female", "sec": 3.6, "text": "اين تم توقيع اتفاقية جنيف ؟"},
  {"utt_id": "utt_3641651783006550377", "speaker": "speaker_2766335412638966296", "locale": "ar_x_gulf", "gender": "female", "sec": 3.54, "text": "متى ولد مارتن لوثر كينغ ؟"},
  {"utt_id": "utt_16874801639434719878", "speaker": "speaker_2766335412638966296", "locale": "ar_x_gulf", "gender": "female", "sec": 3.3, "text": "من هي اكثر الدول المصدرة للصويا ؟"},
  {"utt_id": "utt_7386846959494626945", "speaker": "speaker_2766335412638966296", "locale": "ar_x_gulf", "gender": "female", "sec": 4.8, "text": "كم عدد الدول التي تحتوي على مناجم للألماس ؟"},
  {"utt_id": "utt_12818443576246259372", "speaker": "speaker_2766335412638966296", "locale": "ar_x_gulf", "gender": "female", "sec": 3.42, "text": "ما هي الإمبريالية الجديدة؟"},
  {"utt_id": "utt_5620696431014491769", "speaker": "speaker_15955707582786604846", "locale": "ar_x_levant", "gender": "female", "sec": 5.46, "text": "من قام بأول رحلة على متن الهليكوبتر؟"},
  {"utt_id": "utt_14574410466322756332", "speaker": "speaker_15955707582786604846", "locale": "ar_x_levant", "gender": "female", "sec": 4.98, "text": "ما هي العاصمة السياسية لساحل العاج؟"},
  {"utt_id": "utt_17901247133276363620", "speaker": "speaker_15955707582786604846", "locale": "ar_x_levant", "gender": "female", "sec": 5.22, "text": "ماهو متوسط راتب المرحل الجوي في ألمانيا؟"},
  {"utt_id": "utt_15785469187113633594", "speaker": "speaker_15955707582786604846", "locale": "ar_x_levant", "gender": "female", "sec": 5.22, "text": "في أي عام تولى عبد الفتاح السيسي الحكم في مصر؟"},
  {"utt_id": "utt_6246017701869779345", "speaker": "speaker_15955707582786604846", "locale": "ar_x_levant", "gender": "female", "sec": 3.66, "text": "من هم الخوارزميون؟"},
  {"utt_id": "utt_12647565682551659438", "speaker": "speaker_3621218680844483876", "locale": "ar_x_levant", "gender": "female", "sec": 6.18, "text": "ماهى نوع تربة المجر ؟"},
  {"utt_id": "utt_17814217406148797514", "speaker": "speaker_3621218680844483876", "locale": "ar_x_levant", "gender": "female", "sec": 6.48, "text": "كم تبلغ مساحة مدينة أوراديا الرومانية؟"},
  {"utt_id": "utt_10681321353672392578", "speaker": "speaker_3621218680844483876", "locale": "ar_x_levant", "gender": "female", "sec": 7.32, "text": "ماهي الديانة الرئيسية المتبعة في التوغو؟"},
  {"utt_id": "utt_15196391037180135098", "speaker": "speaker_3621218680844483876", "locale": "ar_x_levant", "gender": "female", "sec": 5.34, "text": "ما هو قانون الجذب العام لنيوتن؟"},
  {"utt_id": "utt_5361324911837820907", "speaker": "speaker_3621218680844483876", "locale": "ar_x_levant", "gender": "female", "sec": 5.04, "text": "متى ولد بشار جعفري؟"},
  {"utt_id": "utt_16662250882608988657", "speaker": "speaker_18311663484321318852", "locale": "ar_x_levant", "gender": "female", "sec": 2.64, "text": "ما هو البروكسي المعادي؟"},
  {"utt_id": "utt_11822220654381765254", "speaker": "speaker_18311663484321318852", "locale": "ar_x_levant", "gender": "female", "sec": 3.3, "text": "متى عاش السلطان سليمان؟"},
  {"utt_id": "utt_13304990201197180525", "speaker": "speaker_18311663484321318852", "locale": "ar_x_levant", "gender": "female", "sec": 2.4, "text": "ما هو التفكير المزدوج؟"},
  {"utt_id": "utt_9334984278026135177", "speaker": "speaker_18311663484321318852", "locale": "ar_x_levant", "gender": "female", "sec": 4.8, "text": "متى ولد عمران أحمد خان نيازي رئيس وزراء باكستان ؟"},
  {"utt_id": "utt_14090549391004942201", "speaker": "speaker_18311663484321318852", "locale": "ar_x_levant", "gender": "female", "sec": 6.06, "text": "في أي عام أعلنت جمهورية صرب البوسنة  إنفصالها عن البوسنة والهرسك؟"},
  {"utt_id": "utt_17130167616474057144", "speaker": "speaker_5041769575752757948", "locale": "ar_x_levant", "gender": "female", "sec": 4.38, "text": "من هي اول شركة منتجة للهاتف المحمول ؟"},
  {"utt_id": "utt_1557175686226158369", "speaker": "speaker_5041769575752757948", "locale": "ar_x_levant", "gender": "female", "sec": 3.3, "text": "ما هي الفلسفة المادية؟"},
  {"utt_id": "utt_13303120592991349291", "speaker": "speaker_5041769575752757948", "locale": "ar_x_levant", "gender": "female", "sec": 3.66, "text": "كم تبعد العقبة على عمّان؟"},
  {"utt_id": "utt_5043965492155064664", "speaker": "speaker_5041769575752757948", "locale": "ar_x_levant", "gender": "female", "sec": 4.86, "text": "أين يتم إنتاج هرمون التستوستيرون؟"},
  {"utt_id": "utt_651308939006318097", "speaker": "speaker_5041769575752757948", "locale": "ar_x_levant", "gender": "female", "sec": 4.5, "text": "من  وصف أول حالة إضطراب شخصية تفارقي؟"},
  {"utt_id": "utt_17894530591720158889", "speaker": "speaker_14786821118033881018", "locale": "ar_x_levant", "gender": "female", "sec": 3.12, "text": "اين يوجد اكبر مكب نفايات في العالم؟"},
  {"utt_id": "utt_6860524926200286349", "speaker": "speaker_14786821118033881018", "locale": "ar_x_levant", "gender": "female", "sec": 3.36, "text": "متى بدأت الأزمة الإقتصادية باليونان؟"},
  {"utt_id": "utt_5190679221402761953", "speaker": "speaker_14786821118033881018", "locale": "ar_x_levant", "gender": "female", "sec": 4.02, "text": "ما هي اصغر قارات العالم من حيث المساحة وعدد السكان؟"},
  {"utt_id": "utt_1704100239678540645", "speaker": "speaker_14786821118033881018", "locale": "ar_x_levant", "gender": "female", "sec": 5.64, "text": "كم دامت رئاسة إلوي ألفارو لجمهورية الإكوادور ؟"},
  {"utt_id": "utt_10840511376537754830", "speaker": "speaker_14786821118033881018", "locale": "ar_x_levant", "gender": "female", "sec": 3.12, "text": "متى تأسس إتحاد المصارعة الأمريكي؟"},
  {"utt_id": "utt_13868562736617912625", "speaker": "speaker_13152551087485730375", "locale": "ar_x_levant", "gender": "female", "sec": 4.2, "text": "متى صنعت أول بطاقة بنكية ذكية؟"},
  {"utt_id": "utt_3303598780392385902", "speaker": "speaker_13152551087485730375", "locale": "ar_x_levant", "gender": "female", "sec": 2.46, "text": "اين عاش نيوتن؟"},
  {"utt_id": "utt_11247338897985164165", "speaker": "speaker_13152551087485730375", "locale": "ar_x_levant", "gender": "female", "sec": 4.38, "text": "من هو تشارلز فرانسيس ريشتر؟"},
  {"utt_id": "utt_6526717700496049745", "speaker": "speaker_13152551087485730375", "locale": "ar_x_levant", "gender": "female", "sec": 3.48, "text": "من هو اشهر شعراء الجاهلية ؟"},
  {"utt_id": "utt_9681184222537452198", "speaker": "speaker_13152551087485730375", "locale": "ar_x_levant", "gender": "female", "sec": 6.84, "text": "متى عين إسماعيل ولد الشيخ أحمد مبعوث الأمم المتحدة الخاص إلى ليبيا؟"},
  {"utt_id": "utt_12855451114612280457", "speaker": "speaker_12727136081786045812", "locale": "ar_x_levant", "gender": "male", "sec": 3.72, "text": "كم مرة ذكر اسم فرعون صراحةً في سورة الأعراف؟"},
  {"utt_id": "utt_11946564670982392481", "speaker": "speaker_12727136081786045812", "locale": "ar_x_levant", "gender": "male", "sec": 2.88, "text": "ماذا يحدث عند موت الخلية النباتية ؟"},
  {"utt_id": "utt_2649988671091112806", "speaker": "speaker_12727136081786045812", "locale": "ar_x_levant", "gender": "male", "sec": 3.84, "text": "في أي سنة تم إغتيال مقتدي الصدر؟"},
  {"utt_id": "utt_1726778958006902910", "speaker": "speaker_12727136081786045812", "locale": "ar_x_levant", "gender": "male", "sec": 4.92, "text": "كم بلغ حجم سفينة نوح حسب وصفها في القرآن ؟"},
  {"utt_id": "utt_11277246174146490255", "speaker": "speaker_12727136081786045812", "locale": "ar_x_levant", "gender": "male", "sec": 3.54, "text": "في أي عام  انضمت أنغولا إلى منظمة الأوبك؟"},
  {"utt_id": "utt_7192130387854603404", "speaker": "speaker_15750893565205641976", "locale": "ar_x_levant", "gender": "male", "sec": 4.2, "text": "كم عام إستمر تصوير مسلسل لعبة العروش ؟"},
  {"utt_id": "utt_4740448375833474457", "speaker": "speaker_15750893565205641976", "locale": "ar_x_levant", "gender": "male", "sec": 5.88, "text": "ما الفرق بين محرك السيارة الكهربائية و سيارة البنزين؟"},
  {"utt_id": "utt_6794235241949914547", "speaker": "speaker_15750893565205641976", "locale": "ar_x_levant", "gender": "male", "sec": 3.6, "text": "متى صدر كتاب \"محمد\" لمصطفى محمود؟"},
  {"utt_id": "utt_14055794240825935938", "speaker": "speaker_15750893565205641976", "locale": "ar_x_levant", "gender": "male", "sec": 3.72, "text": "من هو مؤلف كتاب (فيه مافيه)؟"},
  {"utt_id": "utt_1367546429383842481", "speaker": "speaker_15750893565205641976", "locale": "ar_x_levant", "gender": "male", "sec": 4.8, "text": "أين كانت المدينة التي يعيش فيها باتمان؟"},
  {"utt_id": "utt_12684321039923191398", "speaker": "speaker_17882602710991328342", "locale": "ar_x_levant", "gender": "no_answer", "sec": 2.76, "text": "من هو سيمون بوليفار؟"},
  {"utt_id": "utt_3153221252841647445", "speaker": "speaker_17882602710991328342", "locale": "ar_x_levant", "gender": "no_answer", "sec": 2.58, "text": "هل تدخين الماريجوانا مشرع في كولومبيا؟"},
  {"utt_id": "utt_11039343252117318414", "speaker": "speaker_17882602710991328342", "locale": "ar_x_levant", "gender": "no_answer", "sec": 3.18, "text": "من هو مخرج فيلم شغف المسيح ؟"},
  {"utt_id": "utt_17166885031899413140", "speaker": "speaker_17882602710991328342", "locale": "ar_x_levant", "gender": "no_answer", "sec": 3.0, "text": "من هو صاحب رواية اوليفر تويست؟"},
  {"utt_id": "utt_7439985018398894205", "speaker": "speaker_17882602710991328342", "locale": "ar_x_levant", "gender": "no_answer", "sec": 2.52, "text": "من وعد اليهود بأرض  فلسطين؟"},
  {"utt_id": "utt_7389789295542986270", "speaker": "speaker_11759004673577735118", "locale": "ar_x_levant", "gender": "female", "sec": 2.4, "text": "من هم فقهاء الصحابة ؟"},
  {"utt_id": "utt_8981789496200871767", "speaker": "speaker_11759004673577735118", "locale": "ar_x_levant", "gender": "female", "sec": 3.6, "text": "من أول عالم قام بقياس سرعة الضوء؟"},
  {"utt_id": "utt_15494854461640626850", "speaker": "speaker_11759004673577735118", "locale": "ar_x_levant", "gender": "female", "sec": 3.18, "text": "كم عدد المناطق العشوائية الموجودة في القاهرة ؟"},
  {"utt_id": "utt_15741143077199400456", "speaker": "speaker_11759004673577735118", "locale": "ar_x_levant", "gender": "female", "sec": 1.62, "text": "ما هو الخفان؟"},
  {"utt_id": "utt_4749398404792497644", "speaker": "speaker_11759004673577735118", "locale": "ar_x_levant", "gender": "female", "sec": 3.84, "text": "ما هي ثالث أكبر مدن سوريا من حيث عدد السكان؟"},
  {"utt_id": "utt_18289083938331217171", "speaker": "speaker_7613029910914687309", "locale": "ar_x_levant", "gender": "female", "sec": 4.92, "text": "إلى كم تنقسم مكونات الحاسوب؟"},
  {"utt_id": "utt_14549120167902958344", "speaker": "speaker_7613029910914687309", "locale": "ar_x_levant", "gender": "female", "sec": 5.88, "text": "كم عدد مواسم مسلسل هاو اي ميت يور ماذر ؟"},
  {"utt_id": "utt_363184377256154377", "speaker": "speaker_7613029910914687309", "locale": "ar_x_levant", "gender": "female", "sec": 5.16, "text": "اين تقع الزائدة الدودية؟"},
  {"utt_id": "utt_11232510874044619418", "speaker": "speaker_7613029910914687309", "locale": "ar_x_levant", "gender": "female", "sec": 7.02, "text": "متى تصدر الدينار الكويتي العملات العالمية أول مرة؟"},
  {"utt_id": "utt_15338308419022265581", "speaker": "speaker_7613029910914687309", "locale": "ar_x_levant", "gender": "female", "sec": 5.28, "text": "ما عدد الخُلَفاءُ الأمويين؟"},
  {"utt_id": "utt_602659862937646763", "speaker": "speaker_17903240472957700178", "locale": "ar_x_levant", "gender": "female", "sec": 5.28, "text": "كم عدد لاعبي المنتخب الإنجليزي الاجانب في عام 2009 ؟"},
  {"utt_id": "utt_5419429324543621899", "speaker": "speaker_17903240472957700178", "locale": "ar_x_levant", "gender": "female", "sec": 3.72, "text": "في أي عام ولد إدوارد أورنر غودمان؟"},
  {"utt_id": "utt_2397679799291732392", "speaker": "speaker_17903240472957700178", "locale": "ar_x_levant", "gender": "female", "sec": 4.98, "text": "من أول من قام بتشخيص حالة متلازمة فيرنيك-كورساكوف ؟"},
  {"utt_id": "utt_6158965149047509982", "speaker": "speaker_17903240472957700178", "locale": "ar_x_levant", "gender": "female", "sec": 3.18, "text": "ما هي العملة الرسمية في فيتنام؟"},
  {"utt_id": "utt_14333766029742864826", "speaker": "speaker_17903240472957700178", "locale": "ar_x_levant", "gender": "female", "sec": 2.22, "text": "ماهو ضمور الخلايا؟"},
